	column 'Supply Value' =
			
			DIVIDE (
			    SUMX ( RELATEDTABLE ( FactSupply ), FactSupply[supply_sites] ),
			    SUMX ( RELATEDTABLE ( FactACS ), FactACS[insurance_universe] )
			) * 100000
		isHidden
		formatString: 0.0
		lineageTag: 6bc50926-c928-4140-950e-02370233d677
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'Uninsured Pctl' =
			
			VAR v = DimGeography[Uninsured Value]
			VAR others =
			    FILTER (
			        ALL ( DimGeography[fips], DimGeography[Uninsured Value] ),
			        NOT ISBLANK ( DimGeography[Uninsured Value] )
			    )
			RETURN
			    IF (
			        ISBLANK ( v ),
			        BLANK (),
			        DIVIDE (
			            COUNTROWS ( FILTER ( others, DimGeography[Uninsured Value] < v ) ),
			            COUNTROWS ( others ) - 1
			        ) * 100
			    )
		formatString: 0.0
		lineageTag: 4dbf12e7-1a18-4dc8-8350-d07aae628461
		summarizeBy: none

		annotation SummarizationSetBy = User

