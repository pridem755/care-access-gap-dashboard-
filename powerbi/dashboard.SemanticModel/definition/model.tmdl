model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","DimGeography","FactACS","FactSupply","FactSites","FactPLACES","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table DimGeography
ref table FactACS
ref table FactSupply
ref table FactSites
ref table FactPLACES
ref table _Measures
ref table 'Weight Uninsured'
ref table 'Weight Poverty'
ref table 'Weight Diabetes'
ref table 'Weight High BP'
ref table 'Weight Supply'

ref cultureInfo en-US

